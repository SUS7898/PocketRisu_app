+    // Keyboard twin of the send/stop button. While this chat is generating the
+    // button in that spot is Stop, so the configured send key stops too instead
+    // of toasting "still generating" — on a hardware keyboard that is the only
+    // way to cancel without reaching for the screen.
+    //
+    // A held send key fires send and then auto-repeats, and those repeats would
+    // stop what the press just started. The guard is a time window after the
+    // key-triggered send, not e.repeat: Android WebView never sets the
+    // auto-repeat flag (ImeAdapter passes only the meta state), so on a
+    // hardware keyboard every repeat would read as a fresh press.
+    //
+    // "[SendKey]" warnings are kept by the PocketRisu app's diagnostic log
+    // (console warnings starting with "["). While this chat is generating,
+    // every Enter-like keydown on the composer is reported with the fields the
+    // send-key decision depends on, so a key that arrives changed by the IME
+    // (no Ctrl, composing, keyCode 229) is visible in the log.
+    const SEND_KEY_STOP_GUARD_MS = 1000
+    let lastSendKeyAt = 0
+    let lastSendKeyLogAt = 0
+    function sendKeyDown(e: KeyboardEvent, doSend: () => void = send){
+        if(currentChatGenerating && (e.key.toLocaleLowerCase() === "enter" || e.keyCode === 13 || e.keyCode === 229)){
+            const now = Date.now()
+            if(now - lastSendKeyLogAt > 300){
+                lastSendKeyLogAt = now
+                const mode = isMobile ? DBState.db.sendKeyMobile : DBState.db.sendKeyPC
+                console.warn(`[SendKey] keydown while generating key=${e.key} code=${e.code} keyCode=${e.keyCode} ctrl=${e.ctrlKey} meta=${e.metaKey} shift=${e.shiftKey} alt=${e.altKey} composing=${e.isComposing} repeat=${e.repeat} sendKey=${mode} mobile=${isMobile}`)
+            }
+        }
+        if(e.key.toLocaleLowerCase() !== "enter" || !shouldSendOnEnter(e)) return
+        if(e.isComposing){
+            // The IME takes this Enter to commit its composition (upstream behaviour).
+            if(currentChatGenerating) console.warn('[SendKey] stop ignored: IME composing')
+            return
+        }
+        e.preventDefault()
+        if(currentChatGenerating){
+            const sinceSend = Date.now() - lastSendKeyAt
+            if(sinceSend < SEND_KEY_STOP_GUARD_MS){
+                console.warn(`[SendKey] stop ignored ${sinceSend}ms after send (repeat=${e.repeat})`)
+                return
+            }
+            console.warn(`[SendKey] stop (repeat=${e.repeat})`)
+            abortChat()
+            return
+        }
+        lastSendKeyAt = Date.now()
+        doSend()
+    }
+
