-            if (bodyRoot) resolveInlayPlaceholders(bodyRoot)
+            if (!bodyRoot) return
+            if (resolveInlayPlaceholders(bodyRoot) > 0) return
+            // The placeholder DOM can land after tick(): the {:then} block's
+            // own .then is a separate microtask, and a message rewritten by a
+            // trigger or Lua (Lightboard inserting freshly generated inlays)
+            // can render later still. A placeholder that appears then would
+            // never be observed and the image would stay blank until
+            // something else re-renders the message. So, for messages that
+            // carry inlays at all, watch the subtree for up to 5 s and
+            // resolve as soon as placeholders show up.
+            if (!/\{\{inlay/.test(msgDisplay ?? '')) return
+            const root = bodyRoot
+            let settled = false
+            let timer: ReturnType<typeof setTimeout> | undefined
+            const settle = () => {
+                if (settled) return
+                settled = true
+                watcher.disconnect()
+                clearTimeout(timer)
+            }
+            const tryResolve = () => {
+                if (settled) return
+                if (root.querySelector('[data-inlay-id]') && resolveInlayPlaceholders(root) > 0) settle()
+            }
+            const watcher = new MutationObserver(tryResolve)
+            watcher.observe(root, { childList: true, subtree: true })
+            timer = setTimeout(settle, 5000)
+            requestAnimationFrame(tryResolve)
         })
     })
 </script>
