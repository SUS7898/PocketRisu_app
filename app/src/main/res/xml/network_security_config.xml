<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Session cookies and the server password must never travel in clear text.
     The debug build type overrides this file to permit localhost for emulator testing. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
